{
  "name": "herald",
  "version": "0.0.0",
  "description": "Announces releases and explains them to users",
  "private": true,
  "type": "module",
  "bin": {
    "herald": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "herald": "node src/cli/main.ts",
    "smoke-test": "sh scripts/smoke-test.sh",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
